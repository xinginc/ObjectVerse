<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.objectverse.mapper.CodeFileMapper">

    <resultMap id="CodeFileResultMap" type="com.example.objectverse.entity.CodeFile">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="fileName" column="file_name"/>
        <result property="packageName" column="package_name"/>
        <result property="fileType" column="file_type"/>
        <result property="codeContent" column="code_content"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="CodeFileColumns">
        id,
        project_id,
        file_name,
        package_name,
        file_type,
        code_content,
        create_time,
        update_time,
        deleted
    </sql>

    <insert id="insert" parameterType="com.example.objectverse.entity.CodeFile" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO code_file (
            project_id,
            file_name,
            package_name,
            file_type,
            code_content,
            create_time,
            update_time,
            deleted
        ) VALUES (
            #{projectId},
            #{fileName},
            #{packageName},
            #{fileType},
            #{codeContent},
            #{createTime},
            #{updateTime},
            #{deleted}
        )
    </insert>

    <select id="findByProjectId" resultMap="CodeFileResultMap">
        SELECT
        <include refid="CodeFileColumns"/>
        FROM code_file
        WHERE project_id = #{projectId}
          AND deleted = 0
        ORDER BY create_time DESC, id DESC
    </select>

    <select id="findById" resultMap="CodeFileResultMap">
        SELECT
        <include refid="CodeFileColumns"/>
        FROM code_file
        WHERE id = #{id}
          AND deleted = 0
    </select>
</mapper>
