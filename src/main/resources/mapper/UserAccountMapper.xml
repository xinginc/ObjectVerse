<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.objectverse.mapper.UserAccountMapper">

    <resultMap id="UserAccountResultMap" type="com.example.objectverse.entity.UserAccount">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="email" column="email"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="age" column="age"/>
        <result property="occupation" column="occupation"/>
        <result property="bio" column="bio"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="UserAccountColumns">
        id,
        username,
        password,
        nickname,
        email,
        role,
        status,
        age,
        occupation,
        bio,
        create_time,
        update_time,
        deleted
    </sql>

    <select id="findById" resultMap="UserAccountResultMap">
        SELECT
        <include refid="UserAccountColumns"/>
        FROM user_account
        WHERE id = #{id}
          AND deleted = 0
    </select>

    <select id="findByUsername" resultMap="UserAccountResultMap">
        SELECT
        <include refid="UserAccountColumns"/>
        FROM user_account
        WHERE username = #{username}
          AND deleted = 0
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.example.objectverse.entity.UserAccount" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_account (
            username,
            password,
            nickname,
            email,
            role,
            status,
            age,
            occupation,
            bio,
            create_time,
            update_time,
            deleted
        ) VALUES (
            #{username},
            #{password},
            #{nickname},
            #{email},
            #{role},
            #{status},
            #{age},
            #{occupation},
            #{bio},
            #{createTime},
            #{updateTime},
            #{deleted}
        )
    </insert>

    <update id="updateProfile" parameterType="com.example.objectverse.entity.UserAccount">
        UPDATE user_account
        SET nickname = #{nickname},
            email = #{email},
            age = #{age},
            occupation = #{occupation},
            bio = #{bio},
            update_time = NOW()
        WHERE id = #{id}
          AND deleted = 0
    </update>
</mapper>
