<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.objectverse.mapper.AiConversationMapper">

    <resultMap id="AiConversationResultMap" type="com.example.objectverse.entity.AiConversation">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="taskId" column="task_id"/>
        <result property="agentName" column="agent_name"/>
        <result property="promptContent" column="prompt_content"/>
        <result property="responseContent" column="response_content"/>
        <result property="modelName" column="model_name"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.objectverse.entity.AiConversation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_conversation (
            project_id,
            task_id,
            agent_name,
            prompt_content,
            response_content,
            model_name,
            create_time,
            update_time,
            deleted
        ) VALUES (
            #{projectId},
            #{taskId},
            #{agentName},
            #{promptContent},
            #{responseContent},
            #{modelName},
            #{createTime},
            #{updateTime},
            #{deleted}
        )
    </insert>

    <select id="findByProjectId" resultMap="AiConversationResultMap">
        SELECT
            id,
            project_id,
            task_id,
            agent_name,
            prompt_content,
            response_content,
            model_name,
            create_time,
            update_time,
            deleted
        FROM ai_conversation
        WHERE project_id = #{projectId}
          AND deleted = 0
        ORDER BY create_time DESC, id DESC
    </select>
</mapper>
